.mbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:2px 2px 8px;flex-wrap:wrap}.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{border:1px solid #d9e6f8;background:#f6f9ff;color:#58718d;border-radius:99px;padding:6px 11px;font-size:12px;font-weight:750}.chip.active{background:#2569e8;border-color:#2569e8;color:#fff}.progress{font-size:12px;color:#4b6385;font-weight:750}.progress i{display:block;height:5px;background:#e9eff7;border-radius:9px;margin-top:4px;width:110px;overflow:hidden}.progress i b{display:block;height:100%;width:0;background:#2fae7a;transition:width .3s}.mhead{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.lv{font-size:10.5px;font-weight:800;border-radius:6px;padding:3px 7px}.lv.basic{background:#e5f4ec;color:#1d7a50}.lv.inq{background:#fff2e2;color:#b5660f}.lv.chal{background:#f3eaff;color:#7442b8}.mbtns{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.mission button.setup{background:#fff;color:#2c5a94;border-color:#d6e2f1}.mission .done{margin-left:auto;display:flex;align-items:center;gap:5px;font-size:12px;color:#5e738e;cursor:pointer}.mission .done input{width:18px;height:18px;accent-color:#2fae7a}.mission.complete{opacity:.62}.mission.complete b{text-decoration:line-through;text-decoration-color:#2fae7a}.ask{display:flex;gap:6px;align-items:center;margin:4px 0 8px;flex-wrap:wrap}.ask input{width:110px;border:1px solid #dce5f1;border-radius:9px;padding:8px 9px;font-size:13px}.ask span{font-size:12px;color:#65768c}.fb{font-size:12.5px;margin:6px 0 2px;line-height:1.55}.fb.ok{color:#167045}.fb.no{color:#b54a2a}.fb.info{color:#2c5a94}.mission[hidden]{display:none}
