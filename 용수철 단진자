order-radius:12px;padding:13px 6px;min-height:48px;font-weight:750;font-size:13px;background:#eaf0f8;color:#26466b}.btn.primary{background:#2569e8;color:#fff}.btn.ghost{background:#f1f4f8;color:#4e607a}.btn:disabled{opacity:.5;cursor:not-allowed}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:0 12px 14px}.metric{background:#f6f9fd;border:1px solid #ebf0f7;border-radius:11px;padding:8px 5px;text-align:center;min-width:0}.metric span{display:block;font-size:10px;color:#66788d;margin-bottom:4px}.metric strong{display:block;font-size:13px;letter-spacing:-.2px;font-variant-numeric:tabular-nums}.control{padding:0 18px 15px}.row-label{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:4px 0 6px;font-size:14px}.row-label strong{font-size:14px}.number{font-weight:800;color:#2362ca;font-variant-numeric:tabular-nums}.control input[type=range]{width:100%;height:28px;accent-color:#2b70ed;cursor:pointer}.ticks{display:flex;justify-content:space-between;font-size:11px;color:#8795a8}.toggle{display:flex;justify-content:space-between;align-items:center;padding:4px 18px 18px;gap:10px;font-size:14px}.toggle input{width:23px;height:23px;accent-color:#2b70ed}.notice{font-size:12px;line-height:1.55;color:#5e738e;background:#f3f7ff;border-radius:12px;margin:0 14px 14px;padding:11px 12px}.graph-tabs{display:flex;gap:7px;padding:0 14px 10px}.tab{flex:1;border:1px solid #d9e6f8;background:#f6f9ff;border-radius:10px;min-height:40px;font-size:13px;color:#58718d;font-weight:750}.tab.active{background:#e8f0ff;color:#1e60ca;border-color:#91b9f7}.graph-wrap{margin:0 12px 13px;border:1px solid #e4ebf4;border-radius:13px;overflow:hidden}.graph-wrap canvas{display:block;width:100%;height:auto;aspect-ratio:1.65/1;background:#fff}.explain{font-size:12px;color:#61748a;padding:0 16px 14px;line-height:1.65}.details{padding:0 15px 14px}.details summary{cursor:pointer;list-style:none;padding:13px 3px;font-size:15px;font-weight:800}.details summary::-webkit-details-marker{display:none}.details summary:after{content:'⌄';float:right;color:#64748b}.details[open] summary:after{content:'⌃'}.mission{border-top:1px solid #edf0f5;padding:13px 2px}.mission:first-of-type{border-top:0}.mission b{font-size:14px}.mission p{margin:7px 0;color:#65768c;font-size:13px;line-height:1.6}.mission button{background:#edf4ff;color:#1c5cc1;border:1px solid #cbdcf7;border-radius:9px;padding:9px 11px;font-size:12px;font-weight:750}.answer{margin:8px 0 2px;border-left:3px solid #2b70ed;padding:6px 11px;background:#f5f9ff;font-size:13px;line-height:1.65}.record{padding:0 14px 16px;display:grid;grid-template-columns:1fr 1fr;gap:9px}.record button{grid-column:span 2}.record label{font-size:12px;color:#65758d}.record input{display:block;width:100%;border:1px solid #dce5f1;border-radius:10px;padding:11px;margin-top:5px;font-size:14px}.records{padding:0 14px 16px;overflow:auto}.records table{border-collapse:collapse;width:100%;font-size:12px}.records th,.records td{border-bottom:1px solid #e8edf4;padding:9px 4px;text-align:center}.records th{color:#58718d;background:#f7faff}.foot{text-align:center;font-size:12px;color:#7a8aa0;margin-top:16px;line-height:1.6}.onlymobile{display:none}
